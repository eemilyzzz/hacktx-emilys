# Copy to .streamlit/secrets.toml and fill in YOUR account settings locally.
# The real secrets file and private key files are ignored by Git.
[snowflake]
account = "YOUR_ORG-YOUR_ACCOUNT"
user = "YOUR_USERNAME"
warehouse = "CLUBCAL_WH"
database = "CLUBCAL"
schema = "APP"
role = "CLUBCAL_APP"
workspace = "personal"

# Local interactive OAuth sign-in: opens Snowflake's own login page in your browser.
authenticator = "oauth_authorization_code"
# For accounts configured with organization SAML SSO, use "externalbrowser" instead.

# For unattended reconnects, configure key-pair authentication instead:
# authenticator = "snowflake_jwt"
# private_key_file = "C:/path/to/your/snowflake-key.p8"
# private_key_file_pwd = "YOUR_LOCAL_KEY_PASSPHRASE"
