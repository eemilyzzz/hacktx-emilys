# Optional for fetching public Instagram posts. Uploads and JSON imports work without it.
APIFY_TOKEN=

# Optional for AI interpretation after local OCR.
# Use the endpoint and model available in YOUR Meta dashboard.
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
# For legacy Llama API accounts instead:
# META_BASE_URL=https://api.llama.com/v1
# META_MODEL=Llama-4-Maverick-17B-128E-Instruct-FP8

DEFAULT_TIMEZONE=America/Chicago
